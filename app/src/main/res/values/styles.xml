<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- windowLightNavigationBar requires API 27 -> lives in values-v27/styles.xml -->

    <style name="AppTheme"
        parent="@android:style/Theme.Material.Light.NoActionBar">

        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>

        <!-- Warm soil bars: light icons on a dark surface, so
             windowLight* stays off. -->
        <item name="android:statusBarColor">@color/edunoor_soil_deep</item>

        <item name="android:navigationBarColor">@color/edunoor_soil_deep</item>

        <item name="android:colorAccent">@color/edunoor_gold</item>

    </style>

</resources>
