<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Clay architectural field -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/edunoor_clay_soft"/>
        </shape>
    </item>

    <!-- Gold border -->
    <item
        android:left="7dp"
        android:top="7dp"
        android:right="7dp"
        android:bottom="7dp">

        <shape android:shape="oval">

            <solid android:color="@android:color/transparent"/>

            <stroke
                android:width="1.5dp"
                android:color="@color/edunoor_gold"/>

        </shape>

    </item>

    <!-- Inner arch field -->
    <item
        android:left="17dp"
        android:top="17dp"
        android:right="17dp"
        android:bottom="17dp">

        <shape android:shape="rectangle">

            <solid android:color="@color/edunoor_walnut"/>

            <corners android:radius="32dp"/>

        </shape>

    </item>

    <!-- Knowledge light -->
    <item
        android:left="31dp"
        android:top="31dp"
        android:right="31dp"
        android:bottom="31dp">

        <shape android:shape="oval">
            <solid android:color="@color/edunoor_gold"/>
        </shape>

    </item>

</layer-list>
