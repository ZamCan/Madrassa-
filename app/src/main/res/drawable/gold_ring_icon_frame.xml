<?xml version="1.0" encoding="utf-8"?>
<!-- Gold ring frame placed behind brand_icon (splash + auth header) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft contact shadow disc -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#14000000"/>
        </shape>
    </item>
    <!-- polished gold ring -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="1.5dp" android:color="@color/edunoor_gold"/>
        </shape>
    </item>
</layer-list>
