<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Main parchment -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/edunoor_background"/>
        </shape>
    </item>

    <!-- Upper architectural arch -->
    <item
        android:gravity="top|center_horizontal"
        android:top="30dp"
        android:left="55dp"
        android:right="55dp"
        android:bottom="190dp">

        <shape android:shape="rectangle">

            <solid android:color="@android:color/transparent"/>

            <stroke
                android:width="1dp"
                android:color="@color/edunoor_pattern"/>

            <corners android:radius="100dp"/>

        </shape>

    </item>

    <!-- Secondary inner arch -->
    <item
        android:gravity="top|center_horizontal"
        android:top="47dp"
        android:left="72dp"
        android:right="72dp"
        android:bottom="205dp">

        <shape android:shape="rectangle">

            <solid android:color="@android:color/transparent"/>

            <stroke
                android:width="1dp"
                android:color="@color/edunoor_gold_soft"/>

            <corners android:radius="85dp"/>

        </shape>

    </item>

    <!-- Quiet lower manuscript line -->
    <item
        android:gravity="bottom"
        android:left="38dp"
        android:right="38dp"
        android:bottom="64dp">

        <shape android:shape="rectangle">

            <solid android:color="@color/edunoor_gold_soft"/>

            <corners android:radius="1dp"/>

        </shape>

    </item>

</layer-list>
