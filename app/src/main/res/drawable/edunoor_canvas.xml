<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Main middle-page surface -->
    <item>
        <shape android:shape="rectangle">

            <solid
                android:color="@color/edunoor_background"/>

            <corners android:radius="24dp"/>

        </shape>
    </item>

    <!-- Architectural outer frame -->
    <item
        android:left="7dp"
        android:top="7dp"
        android:right="7dp"
        android:bottom="7dp">

        <shape android:shape="rectangle">

            <solid
                android:color="@android:color/transparent"/>

            <stroke
                android:width="1dp"
                android:color="@color/edunoor_pattern"/>

            <corners android:radius="20dp"/>

        </shape>

    </item>

    <!-- Upper architectural arch -->
    <item
        android:gravity="top|center_horizontal"
        android:left="24dp"
        android:right="24dp"
        android:top="18dp"
        android:bottom="125dp">

        <shape android:shape="rectangle">

            <solid
                android:color="@android:color/transparent"/>

            <stroke
                android:width="1dp"
                android:color="@color/edunoor_gold_soft"/>

            <corners android:radius="110dp"/>

        </shape>

    </item>

    <!-- Inner restrained arch -->
    <item
        android:gravity="top|center_horizontal"
        android:left="40dp"
        android:right="40dp"
        android:top="30dp"
        android:bottom="140dp">

        <shape android:shape="rectangle">

            <solid
                android:color="@android:color/transparent"/>

            <stroke
                android:width="1dp"
                android:color="@color/edunoor_pattern"/>

            <corners android:radius="95dp"/>

        </shape>

    </item>

    <!-- Lower manuscript ornament -->
    <item
        android:gravity="bottom|center_horizontal"
        android:left="70dp"
        android:right="70dp"
        android:bottom="16dp"
        android:height="2dp">

        <shape android:shape="rectangle">

            <solid
                android:color="@color/edunoor_gold_soft"/>

            <corners android:radius="2dp"/>

        </shape>

    </item>

</layer-list>
