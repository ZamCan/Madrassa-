<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto-backup policy for Android 9-11 (API 26-30).
    Twin of data_extraction_rules.xml (API 31+): nothing leaves the
    device through platform backup; recovery is owned by the app's
    own encrypted-backup stage (spec section 19).
-->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
