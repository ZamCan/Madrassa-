<?xml version="1.0" encoding="utf-8"?>
<!--
    EduNoor backup & transfer policy (spec section 19: security/privacy).

    Parent/madrassa records never leave the device through platform
    backups or device-to-device migration. Recovery is owned by the
    app's own encrypted-backup stage, so the platform rules stay
    fully disabled instead of partially opted-in.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
