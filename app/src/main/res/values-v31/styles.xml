<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        API 31+: the system owns the first splash. It is tinted with
        the same earthen soil plate as the launcher icon, so the
        system splash, the launcher tile and SplashActivity read as
        one continuous brand entrance rather than a white flash
        followed by an unrelated second screen.
    -->
    <style name="AppTheme"
        parent="@android:style/Theme.Material.Light.NoActionBar">

        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>

        <item name="android:statusBarColor">@color/edunoor_soil_deep</item>

        <item name="android:navigationBarColor">@color/edunoor_soil_deep</item>

        <item name="android:colorAccent">@color/edunoor_gold</item>

        <item name="android:windowSplashScreenBackground">
            @color/edunoor_soil_deep
        </item>

        <item name="android:windowSplashScreenAnimatedIcon">
            @mipmap/ic_launcher
        </item>

        <item name="android:windowSplashScreenIconBackgroundColor">
            @color/edunoor_emerald_deep
        </item>

    </style>

</resources>
