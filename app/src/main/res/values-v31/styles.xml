<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        API 31+: the system owns the first splash. Tinting it with
        the EduNoor emerald night canvas makes the system splash and
        SplashActivity read as one continuous brand entrance instead
        of a white flash followed by a second screen.
    -->
    <style name="AppTheme"
        parent="@android:style/Theme.Material.Light.NoActionBar">

        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/edunoor_background</item>

        <item name="android:navigationBarColor">@color/edunoor_background</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:colorAccent">@color/edunoor_clay</item>

        <item name="android:windowSplashScreenBackground">
            @color/edunoor_emerald_deep
        </item>

    </style>

</resources>
