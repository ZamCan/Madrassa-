<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Opt-in only: powers the device-events list inside the
         dual calendar page, requested at runtime when the user
         taps "connect". Nothing is written or uploaded. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application
        android:theme="@style/AppTheme"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="@xml/full_backup_content"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true">

        <activity
            android:name=".SoloLearningActivity"
            android:exported="false" />

        <activity
            android:name="com.zamcan.madrassa.solo.LessonActivity"
            android:exported="false" />

        <activity
            android:name="com.zamcan.madrassa.core.calendar.CalendarActivity"
            android:exported="false" />

        <activity
            android:name="com.zamcan.madrassa.core.deen.DeenPanelActivity"
            android:exported="false" />

        <activity
            android:name="com.zamcan.madrassa.role.RoleDashboardActivity"
            android:exported="false" />

        <activity
            android:name="com.zamcan.madrassa.role.RoleListActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".auth.parent.ParentLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".auth.ustadh.UstadhLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".InitializationActivity"
            android:exported="false" />

        <activity
            android:name=".registration.MadrassaRegistrationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SplashActivity"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

    </application>

</manifest>
