<?xml version="1.0" encoding="utf-8"?>
<manifest package="com.zamcan.madrassa" xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <application android:theme="@style/AppTheme" android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".SoloLearningActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".auth.parent.ParentLoginActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".auth.ustadh.UstadhLoginActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".InitializationActivity" android:exported="false" />
        <activity android:name=".registration.MadrassaRegistrationActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <receiver android:name=".salah.AdhanAlarmReceiver" android:exported="false" />
        <activity android:name=".SplashActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
